node_modules/
server/target/
.DS_Store
.env

server/web-dist/
ui/.svelte-kit/

# local tooling
.shots/
.preview/

skills/sveltekit-svelte5-tailwind-skill/

.pi/

# Assembled static client (npm run client:publish)
dist/

# Local planning bundle (per-session handoffs and next-development plans)
local/

# Build artefacts of the (out-of-tree) mobile core crate
mobile-core/target/

# Accounting dashboard: a live access token and the rejected-attempt log (client IPs)
accounting/dashboard.token
accounting/auth_fails.log

# Python bytecode
__pycache__/
*.pyc

# Local usage database (measured quota data, not published)
usage.db
accounting/hardware.local.json

# GIMP sources keep their editable history outside the repo.
*.xcf

# Test-run artifacts: `server/tailcat` is a symlink into a throwaway /tmp dir that a
# crashed integration run left behind. Never commit it.
/server/tailcat

# Fuentes editables de GIMP: material de trabajo pesado, no artefactos del repo.
# Documentadas en odd/assets/OKF-MANIFEST.md, que sí se versiona.
*.xcf

# Material de trabajo pesado: las fuentes editables y las pruebas descartadas
# viven aqui, fuera de git. Lo que SI se versiona es el manifiesto de cada
# carpeta, que dice que hay y por que, para que no se pierda el rastro.
odd/assets/borradores/*
odd/assets/descartados/*
!odd/assets/borradores/OKF-MANIFEST.md
!odd/assets/descartados/OKF-MANIFEST.md
